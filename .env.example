# ── Nourish environment ──
# Postgres (Neon on Vercel; local docker: postgres://nourish:nourish@localhost:5434/nourish)
DATABASE_URL=
# Public origin, used for passkeys (RP ID), OAuth redirects and push subject
APP_ORIGIN=https://nourish-xxx.vercel.app
# ≥ 32 random chars: openssl rand -base64 48
SESSION_SECRET=
# Encryption key for retailer OAuth tokens (openssl rand -base64 48)
TOKEN_ENC_KEY=
# Owner password hash: npm run hash-password -- "dlouhá passphrase"
OWNER_PASSWORD_HASH=
# Web push (npx web-push generate-vapid-keys)
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=https://nourish-xxx.vercel.app
# Vercel Cron + external scheduler bearer token
CRON_SECRET=
# AI: on Vercel the OIDC token authenticates AI Gateway automatically; locally use `vercel env pull` or AI_GATEWAY_API_KEY
# AI_GATEWAY_API_KEY=
# AI_MODEL=anthropic/claude-sonnet-5.5
# Free AI (Cloudflare Workers AI worker in workers/vision) — default backend when both are set
VISION_WORKER_URL=https://nourish-vision.<your-subdomain>.workers.dev
VISION_SECRET=
# AI_PROVIDER=gateway   # use Claude via Vercel AI Gateway instead (needs a card on the Vercel team)
# Local only: password when OWNER_PASSWORD_HASH is empty (never used in production)
# DEV_PASSWORD=nourish-dev-heslo
