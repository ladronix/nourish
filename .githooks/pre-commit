#!/bin/sh
# Blocks commits that contain secrets — this repo is public. Enable once per clone:
#   git config core.hooksPath .githooks
if command -v gitleaks >/dev/null 2>&1; then
  gitleaks git --pre-commit --staged --redact --no-banner . || {
    echo "✗ gitleaks found a possible secret in the staged changes – commit refused." >&2
    exit 1
  }
else
  echo "! gitleaks not installed (brew install gitleaks) – secret check skipped." >&2
fi
